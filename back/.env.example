# Copy this file to .env and replace the placeholder values.

# development: Flask dev server with reload + seeding. production: Gunicorn, seeding disabled.
# docker-compose.prod.yml forces production regardless of this value.
FLASK_ENV=development
LOG_LEVEL=INFO

# Used when running the backend directly on the host (poetry run ...).
# Inside Docker Compose these are overridden to point at the "postgres" service.
DATABASE_URL=postgresql+psycopg://miseventos:change-me@localhost:5432/miseventos
TEST_DATABASE_URL=postgresql+psycopg://miseventos:change-me@localhost:5432/miseventos_test

# Must be at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# With FLASK_ENV=production the backend refuses to start if the key still contains a placeholder
# ("replace-with", "change-me") or has fewer than 16 distinct characters. Use a different key per
# environment and keep it stable: changing it invalidates every issued token.
JWT_SECRET_KEY=replace-with-a-long-random-secret-of-at-least-32-chars
JWT_EXPIRATION_MINUTES=60

# Production only (Gunicorn). Optional.
# GUNICORN_WORKERS=2
# GUNICORN_TIMEOUT=30

# Comma-separated list of origins allowed to call /api/*. Needed for "npm start" (ng serve on
# :4200 calls :5000 directly). The dockerized frontend uses the same-origin Nginx proxy instead.
CORS_ORIGINS=http://localhost:4200

# Cloudinary (event cover images). Optional: leave the three credentials empty to disable image
# uploads (the image endpoints then answer 503; everything else works). Set all three or none.
# Values: Cloudinary console > Settings > API Keys. The API secret stays in the backend only: it is
# never sent to the browser nor logged. Never commit real values.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder for the uploads (lowercase letters, digits, "-" or "_"). Use one per environment.
CLOUDINARY_FOLDER=mis-eventos
# Maximum image size in bytes (default 5 MB).
EVENT_IMAGE_MAX_BYTES=5242880

# Initial data created by "flask seed-initial-data" (run by Docker before the server starts).
# Every seed is disabled unless set to true, and the command refuses to run when
# FLASK_ENV=production. Existing users are never modified. Passwords: 8-128 characters.
# In production any SEED_*_ENABLED=true makes the backend refuse to start, and
# docker-compose.prod.yml forces all of them to false.
SEED_ADMIN_ENABLED=true
SEED_ADMIN_NAME=Admin Mis Eventos
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-this-admin-password

SEED_ORGANIZER_ENABLED=true
SEED_ORGANIZER_NAME=Organizer Mis Eventos
SEED_ORGANIZER_EMAIL=organizer@example.com
SEED_ORGANIZER_PASSWORD=change-this-organizer-password

SEED_ATTENDEE_ENABLED=true
SEED_ATTENDEE_NAME=Attendee Mis Eventos
SEED_ATTENDEE_EMAIL=attendee@example.com
SEED_ATTENDEE_PASSWORD=change-this-attendee-password

# Demo speakers, events and sessions owned by the seed organizer (requires SEED_ORGANIZER_ENABLED).
SEED_DEMO_DATA_ENABLED=true

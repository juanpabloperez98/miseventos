# Copy this file to .env and replace the placeholder values.
# Variables used by the root docker-compose.yml (infrastructure shared by all services).
# Application settings live in back/.env.

POSTGRES_DB=miseventos
POSTGRES_USER=miseventos
POSTGRES_PASSWORD=change-me

# Host ports published by Docker Compose.
# The production file (docker-compose.prod.yml) only publishes FRONTEND_HOST_PORT.
POSTGRES_HOST_PORT=5432
BACKEND_HOST_PORT=5000
# Angular app served by Nginx (which also proxies /api/ to the backend).
FRONTEND_HOST_PORT=4200

# Backend settings file used by Compose (default: ./back/.env). Point it to a file outside the
# repository for production, e.g. BACKEND_ENV_FILE=/etc/miseventos/backend.env
# BACKEND_ENV_FILE=./back/.env

# Rendered by the nginx image entrypoint (envsubst). Only variables defined in the container
# environment are replaced (see ENV in front/Dockerfile): ${BACKEND_UPSTREAM}, ${HTTPS_REDIRECT},
# ${HSTS_HEADER}. Nginx's own $variables are left untouched.

# ---------------------------------------------------------------------------------------------
# TLS terminated by an external reverse proxy / load balancer
# ---------------------------------------------------------------------------------------------
# The external proxy must set X-Forwarded-Proto (and overwrite any client value). Without that
# header the request reached Nginx directly, so its own scheme is used.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

# HTTPS_REDIRECT=1: redirect only requests the external proxy reports as plain HTTP. Requests
# without the header (Docker health checks, internal traffic) are never redirected, so there are
# no redirect loops.
map $http_x_forwarded_proto $redirect_to_https {
    default 0;
    http    ${HTTPS_REDIRECT};
}

# HSTS_HEADER (e.g. "max-age=300") is only sent on responses served over HTTPS. Empty value
# (default) = no header. Increase max-age only after HTTPS is confirmed for every host.
map $forwarded_proto $hsts_header {
    default "";
    https   "${HSTS_HEADER}";
}

server {
    listen 80;
    listen [::]:80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;

    if ($redirect_to_https) {
        return 301 https://$host$request_uri;
    }

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # Docker's embedded DNS. Resolving the upstream per request (through a variable) lets Nginx
    # start even if the backend is not running yet, and follows backend container restarts.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $backend_upstream ${BACKEND_UPSTREAM};

    # Security headers. "add_header" in a location replaces the server-level ones, so every
    # location below includes this file.
    #   - script-src 'self': the app only loads its own bundles (no inline scripts, no eval).
    #   - style-src 'unsafe-inline': Angular inserts component styles as <style> elements.
    #   - connect-src 'self': API calls go to the same origin (/api).
    include /etc/nginx/snippets/security-headers.conf;

    # REST API. Backend routes already start with /api, so the URI is forwarded unchanged.
    location /api/ {
        include /etc/nginx/snippets/security-headers.conf;
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        client_max_body_size 1m;
    }

    # Hashed build artifacts (main-XXXX.js, chunk-XXXX.js, styles-XXXX.css): cache for a year.
    location ~* "-[A-Z0-9]{8}\.(?:js|css)$" {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Angular routes: unknown paths fall back to index.html (SPA). index.html is never cached so a
    # new deployment is picked up immediately.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
